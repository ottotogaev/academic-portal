APP_ENV=production
APP_DEBUG=false
APP_URL=https://example.uz
APP_DEFAULT_LOCALE=uz
APP_TIMEZONE=Asia/Tashkent

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=academic_portal
DB_USERNAME=academic_portal_user
DB_PASSWORD=replace_with_secure_password

SESSION_SECURE=true
UPLOAD_MAX_SIZE=10485760

# Contact form, menu item and inbox. Keep false until the site is finished, then set true.
FEATURE_CONTACT=false
